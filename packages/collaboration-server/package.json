{
  "name": "@blocknote/collaboration-server",
  "homepage": "https://github.com/pproenca/BlockNote",
  "private": false,
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pproenca/BlockNote.git",
    "directory": "packages/collaboration-server"
  },
  "license": "MPL-2.0",
  "version": "0.52.1",
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "types",
    "src"
  ],
  "keywords": [
    "blocknote",
    "collaboration",
    "server",
    "typescript"
  ],
  "description": "Environment-neutral collaboration server runtime for BlockNote.",
  "type": "module",
  "source": "src/index.ts",
  "types": "./types/src/index.d.ts",
  "main": "./dist/blocknote-collaboration-server.cjs",
  "module": "./dist/blocknote-collaboration-server.js",
  "exports": {
    ".": {
      "types": "./types/src/index.d.ts",
      "import": "./dist/blocknote-collaboration-server.js",
      "require": "./dist/blocknote-collaboration-server.cjs"
    },
    "./internal": {
      "types": "./types/src/runtime/internal.d.ts",
      "import": "./dist/internal.js",
      "require": "./dist/internal.cjs"
    }
  },
  "scripts": {
    "dev": "vp dev",
    "build": "tsgo && vp build",
    "lint": "vp lint src",
    "test": "vp test --run --passWithNoTests",
    "test:unit": "vp test --run --passWithNoTests",
    "test-watch": "vp test watch",
    "typecheck": "tsgo --noEmit",
    "clean": "rimraf dist && rimraf types"
  },
  "dependencies": {
    "@blocknote/core": "workspace:^",
    "@hocuspocus/common": "catalog:collaboration",
    "@y/protocols": "^1.0.6-rc.1",
    "@y/y": "14.0.0-rc.23"
  },
  "devDependencies": {
    "rimraf": "^5.0.10",
    "typescript": "^5.9.3",
    "vite-plus": "catalog:"
  }
}
