{
  "name": "@blocknote/collaboration",
  "homepage": "https://github.com/pproenca/BlockNote",
  "private": false,
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pproenca/BlockNote.git",
    "directory": "packages/collaboration"
  },
  "license": "MPL-2.0",
  "version": "0.52.1",
  "files": [
    "dist",
    "types",
    "src"
  ],
  "keywords": [
    "blocknote",
    "collaboration",
    "editor",
    "typescript"
  ],
  "description": "Environment-neutral browser collaboration sessions for BlockNote.",
  "type": "module",
  "source": "src/index.ts",
  "types": "./types/src/index.d.ts",
  "main": "./dist/blocknote-collaboration.cjs",
  "module": "./dist/blocknote-collaboration.js",
  "exports": {
    ".": {
      "types": "./types/src/index.d.ts",
      "import": "./dist/blocknote-collaboration.js",
      "require": "./dist/blocknote-collaboration.cjs"
    }
  },
  "scripts": {
    "dev": "vp dev",
    "build": "tsgo && vp build",
    "lint": "vp lint src",
    "test": "vp test --run --passWithNoTests",
    "test:unit": "vp test --run --passWithNoTests",
    "test-watch": "vp test watch",
    "typecheck": "tsgo --noEmit",
    "clean": "rimraf dist && rimraf types"
  },
  "dependencies": {
    "@blocknote/core": "workspace:^",
    "@hocuspocus/provider": "catalog:collaboration",
    "@y/protocols": "^1.0.6-rc.1",
    "@y/y": "14.0.0-rc.23",
    "y-indexeddb": "catalog:collaboration"
  },
  "devDependencies": {
    "rimraf": "^5.0.10",
    "typescript": "^5.9.3",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@blocknote/core": "^0.52.1"
  }
}
